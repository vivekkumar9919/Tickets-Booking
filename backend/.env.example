# ==============================================================================
# Paytm Money: High-Concurrency Seat Reservation Service Environment Variables
# Copy this file to backend/.env:
#   cp .env.example .env
# ==============================================================================

# Application Port
# 4000 is recommended for local development to avoid conflicts with other apps on port 3000
PORT=4000

# Runtime Environment (development | production | test)
NODE_ENV=development

# PostgreSQL Database Connection String
# - For Local Host Development: postgres://postgres:postgrespassword@localhost:5432/ticket_booking
# - For Docker Compose (internal network): postgres://postgres:postgrespassword@postgres:5432/ticket_booking
# - For Cloud (Railway / Render / Neon): ${{DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/ticket_booking

# Database Connection Pool Configuration
# High-concurrency tuning: min idle connections and max active connections
DB_POOL_MIN=5
DB_POOL_MAX=30

# PostgreSQL Transaction Lock Timeout (in milliseconds)
# Eliminates indefinite hanging on row locks under high concurrency (fails fast with 409)
DB_LOCK_TIMEOUT_MS=2000

# Winston Structured Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# Hold Duration Configuration (in seconds)
# Default duration for seats placed on temporary hold
HOLD_DURATION_SECONDS=30
